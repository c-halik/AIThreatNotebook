# Used by docker-compose.yml's `app` service `image:` field.
# Local dev doesn't need this - compose falls back to building a local image.
# Note: GHCR image names must be lowercase, unlike the repo name itself.
APP_IMAGE=ghcr.io/c-halik/aithreatnotebook:latest

# --- Prisma AIRS (Palo Alto Networks AI Runtime Security) ----------------
# Enables the live Prisma AIRS integration in the Live Vendor Test tab -
# leave both unset to keep using the local mock for this vendor. Create an
# API key and a security profile in Strata Cloud Manager, see
# https://pan.dev/prisma-airs/api/airuntimesecurity/airuntimesecurityapi/
PRISMA_AIRS_API_KEY=
PRISMA_AIRS_PROFILE_NAME=
# Uncomment to use a non-US regional endpoint instead:
# PRISMA_AIRS_BASE_URL=https://service-de.api.aisecurity.paloaltonetworks.com
# PRISMA_AIRS_BASE_URL=https://service-in.api.aisecurity.paloaltonetworks.com
# PRISMA_AIRS_BASE_URL=https://service-sg.api.aisecurity.paloaltonetworks.com

# --- Zscaler AI Guard (Detection-as-a-Service / DAS-API mode) ------------
# Enables the live Zscaler integration in the Live Vendor Test tab - leave
# both unset to keep using the local mock for this vendor. Create an API key
# under AI Guard > AI Applications > Add API Keys, and a policy under AI
# Guard > Policy > Configurations (note its numeric Policy ID), see
# https://help.zscaler.com/secure-ai-apps-infra/quick-start-guide-dasapi-mode
ZSCALER_AI_GUARD_API_KEY=
ZSCALER_AI_GUARD_POLICY_ID=
# ZSCALER_AI_GUARD_BASE_URL=https://api.zseclipse.net

# --- CrowdStrike AIDR (AI Detection and Response) -----------------------
# Register an Application collector under AI detection and response >
# Collectors in the Falcon console, assign it a policy, then copy its token
# and base URL from the collector's Config tab. The policy is bound to the
# collector, so there's no policy ID. Leave the token unset to keep the mock.
# https://aidr-docs.crowdstrike.com/docs/aidr/apis
CROWDSTRIKE_AIDR_TOKEN=
# Set this to the base URL from the Config tab if your cloud differs (US-1/US-2/EU-1):
# CROWDSTRIKE_AIDR_BASE_URL=https://api.crowdstrike.com/aidr/aiguard
